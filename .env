APP_NAME=Sokodrop
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=base64:Xb5Mmamtg2qs6GQE8pTK8ZqFJZmcKuJKXQXxlq5wii8=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------
# Database — MySQL per master directive rule #2 (Normalized to 3NF).
# Update these to match your local MySQL / XAMPP / Docker setup.
# --------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sokodrop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sokodrop.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------
# Sanctum — required for the auth:sanctum middleware used on every
# protected route in routes/api.php. SANCTUM_STATEFUL_DOMAINS matters
# only if the frontend consumes the API as a first-party SPA on a
# shared domain (cookie-based auth); the bearer-token flow used by
# AuthController::login works regardless.
# --------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,::1
SESSION_DOMAIN=localhost

# --------------------------------------------------------------------
# Frontend origin — used for CORS (config/cors.php) so the Vite dev
# server (frontend/) can call this API in local development.
# --------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------------
# Payment gateways (stubs) — wired into App\Services\PaymentService's
# dispatchToGateway(). Fill in real credentials before going live;
# PaymentService logs a stub call when these are blank, so the app runs
# locally without them.
# --------------------------------------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
TIGOPESA_API_KEY=
AIRTELMONEY_CLIENT_ID=
AIRTELMONEY_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"